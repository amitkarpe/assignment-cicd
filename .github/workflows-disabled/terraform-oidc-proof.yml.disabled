# Disabled by runner-economy rollout; preserved for reversible reuse.
name: Terraform AWS OIDC proof

on:
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

jobs:
  terraform-proof:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: terraform
    env:
      TF_IN_AUTOMATION: "true"
      TF_VAR_run_id: ${{ github.run_id }}

    steps:
      - uses: actions/checkout@v4

      - uses: hashicorp/setup-terraform@v3

      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::063884340510:role/github-actions-assignment-cicd-chatgpt-lab
          aws-region: ap-southeast-1

      - name: Terraform init and validate
        run: |
          terraform init -input=false
          terraform validate

      - name: Terraform apply
        run: terraform apply -auto-approve -input=false

      - name: Verify created bucket
        shell: bash
        run: |
          set -euo pipefail
          BUCKET=$(terraform output -raw bucket_name)
          aws s3api head-bucket --bucket "$BUCKET"
          echo "Verified $BUCKET"

      - name: Terraform destroy
        if: always()
        run: terraform destroy -auto-approve -input=false

      - name: Verify cleanup
        if: always()
        shell: bash
        run: |
          set -euo pipefail
          BUCKET="chatgpt-gh-oidc-tf-proof-340510-${GITHUB_RUN_ID}"
          if aws s3api head-bucket --bucket "$BUCKET" >/dev/null 2>&1; then
            echo "Bucket still exists: $BUCKET"
            exit 1
          fi
          echo "Cleanup verified: $BUCKET is absent"
